# ==============================================================================
# DeHealth Mobile Client Environment Configuration
# ==============================================================================
# Copy this file to mobile/.env and fill in your actual values.
# All EXPO_PUBLIC_* variables are exposed to the client bundle at build time.
# ==============================================================================

# Supabase project URL (e.g. https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase publishable key (safe for client distribution with RLS enabled).
# Use the publishable key from your project's API settings. Never put a secret or
# service_role key in any EXPO_PUBLIC_* variable: it is bundled into the app.
# The legacy EXPO_PUBLIC_SUPABASE_ANON_KEY is still read as a fallback when this
# variable is empty, so existing setups keep working.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key-here"

# Public JSON-RPC endpoint for Arbitrum Sepolia testnet (Chain ID: 421614)
EXPO_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"

# DeHealthRewardGate smart contract address deployed on Arbitrum Sepolia
EXPO_PUBLIC_REWARD_GATE_ADDRESS="0x0000000000000000000000000000000000000000"

# DeHealthToken ($DHT) ERC-20 smart contract address deployed on Arbitrum Sepolia
EXPO_PUBLIC_DHT_TOKEN_ADDRESS="0x0000000000000000000000000000000000000000"

# Optional local admin governance unlock PIN override.
# Leave blank so users are prompted on first open to set a 4-8 digit PIN
# persisted locally on-device in Expo SecureStore (never hardcoded or sent off-device).
EXPO_PUBLIC_GOVERNANCE_PIN=""
