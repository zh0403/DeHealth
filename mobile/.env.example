# ==============================================================================
# DeHealth Mobile Client Phase 3.0 Environment Configuration
# ==============================================================================
# Copy this file to mobile/.env and fill in your actual values.
# All EXPO_PUBLIC_* variables are exposed to the client bundle at build time.
# ==============================================================================

# Supabase project URL (e.g. https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous/Public API key (Safe for client distribution with RLS enabled)
EXPO_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-token"

# Public JSON-RPC endpoint for Arbitrum Sepolia testnet (Chain ID: 421614)
EXPO_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"

# DeHealthRewardGate smart contract address deployed on Arbitrum Sepolia
EXPO_PUBLIC_REWARD_GATE_ADDRESS="0x0000000000000000000000000000000000000000"

# DeHealthToken ($DHT) ERC-20 smart contract address deployed on Arbitrum Sepolia
EXPO_PUBLIC_DHT_TOKEN_ADDRESS="0x0000000000000000000000000000000000000000"
